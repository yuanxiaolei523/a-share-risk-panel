SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender@example.com
SMTP_PASS=your_smtp_auth_code
MAIL_FROM=A股开盘提醒 <your_sender@example.com>
MAIL_TO=your_receiver@example.com

# 多只持仓用英文逗号分隔，格式：股票代码:成本价
HOLDINGS=600900:27.723
# 旧写法仍兼容：
# HOLDING_CODE=600900
# HOLDING_COST=27.723
WATCH_CODES=600900,600036,000651,000333,601398
CAPITAL=100000
RISK_PCT=1
MAX_POSITION_PCT=20
